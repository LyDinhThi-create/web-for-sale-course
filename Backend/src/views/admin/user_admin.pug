extends ../layouts/admin.pug

block styles
  link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  style.
    /* CSS Riêng cho trang User */
    .card-header {
      background: white;
      border-bottom: 1px solid #f0f2f5;
      padding: 20px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }
    
    /* Search Box Styles */
    .search-box {
      position: relative;
      min-width: 300px;
    }
    .search-box input {
      width: 100%;
      padding: 10px 15px 10px 40px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      outline: none;
      transition: all 0.3s;
    }
    .search-box input:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    .search-box i {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: #a0aec0;
    }

    /* Filter Buttons */
    .filter-group .btn-filter {
      margin-left: 10px;
      border: 1px solid #e2e8f0;
      background: white;
      color: #64748b;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      transition: all 0.2s;
    }
    .filter-group .btn-filter.active,
    .filter-group .btn-filter:hover {
      background: #f1f5f9;
      color: #667eea;
      border-color: #667eea;
    }

    /* Table Styles */
    .user-table th {
      background: #f8fafc;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0.5px;
      padding: 15px 25px;
      border-bottom: 1px solid #e2e8f0;
    }
    .user-table td {
      padding: 15px 25px;
      vertical-align: middle;
      border-bottom: 1px solid #f1f5f9;
      color: #334155;
      font-size: 14px;
    }
    .user-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .avatar-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 16px;
    }
    
    /* Badges */
    .status-badge {
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }
    .status-active { background: #dcfce7; color: #166534; }
    .status-inactive { background: #fee2e2; color: #991b1b; }
    
    /* Actions */
    .action-btn {
      width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      color: #64748b;
      transition: all 0.2s;
      margin-right: 5px;
      background: #f8fafc;
    }
    .action-btn:hover { background: #e2e8f0; color: #334155; }
    .action-btn.delete:hover { background: #fee2e2; color: #ef4444; }

block content
  
    .card.shadow-sm.border-0.mb-4(style="border-radius: 15px; overflow: hidden;")
      //- Header & Filters
      .card-header
        h5.mb-0.font-weight-bold Danh sách Học viên
        
        .d-flex.align-items-center
          //- Form tìm kiếm
          form#form-search.search-box.me-3(method="GET")
            i.fa-solid.fa-search
            input(type="text", name="keyword", placeholder="Tìm kiếm theo tên hoặc email...", value=keyword)

          //- Bộ lọc trạng thái
          .filter-group
            button.btn-filter(class=!status ? 'active' : '', onclick="filterStatus('')") Tất cả
            button.btn-filter(class=status == 'active' ? 'active' : '', onclick="filterStatus('active')") Hoạt động
            button.btn-filter(class=status == 'inactive' ? 'active' : '', onclick="filterStatus('inactive')") Đã khóa

      //- Table Content
      .card-body.p-0
        .table-responsive
          table.table.user-table.mb-0
            thead
              tr
                th Học viên
                th Ngày đăng ký
                th Khóa học
                th Vai trò
                th Trạng thái
                th Thao tác
            tbody
              if users.length > 0
                each user in users
                  tr
                    td
                      .user-info
                        //- Nếu có ảnh thì hiện ảnh, không thì hiện Avatar chữ cái đầu
                        if user.avatar
                          img.avatar-circle(src=user.avatar, style="object-fit: cover")
                        else
                          .avatar-circle #{user.fullname.charAt(0).toUpperCase()}
                        
                        .d-flex.flex-column
                          span.font-weight-bold #{user.fullname}
                          span.text-xs.text-muted #{user.email}
                    
                    td #{new Date(user.createdAt).toLocaleDateString('vi-VN')}
                    
                    td
                      //- Giả sử user có trường courses_owned là mảng ID
                      if user.courses_owned
                        span.badge.bg-light.text-dark #{user.courses_owned.length} khóa
                      else 
                        span.badge.bg-light.text-dark 0 khóa

                    td 
                      span.badge.bg-secondary Học viên

                    td
                      if user.status === 'active'
                        span.status-badge.status-active Hoạt động
                      else
                        span.status-badge.status-inactive Dừng hoạt động
                    
                    td
                      a.action-btn(href=`/admin/users/edit/${user.id}`, title="Chỉnh sửa")
                        i.fa-regular.fa-pen-to-square
                      
                      button.action-btn(onclick=`changeStatus('${user.id}', '${user.status}')`, title="Đổi trạng thái")
                         i.fa-solid.fa-rotate
                      
                      button.action-btn.delete(onclick=`deleteUser('${user.id}')`, title="Xóa")
                        i.fa-regular.fa-trash-can
              else
                tr
                  td.text-center.py-4(colspan="6") Không tìm thấy học viên nào.

      //- Pagination (Phân trang)
      if pagination.totalPage > 1
        .card-footer.bg-white.py-3
          nav
            ul.pagination.justify-content-center.mb-0
              //- Logic nút Prev
              li.page-item(class=pagination.currentPage == 1 ? "disabled" : "")
                button.page-link(onclick=`changePage(${pagination.currentPage - 1})`) 
                  i.fa-solid.fa-chevron-left
              
              //- Logic các số trang
              - for (var i = 1; i <= pagination.totalPage; i++)
                li.page-item(class=pagination.currentPage == i ? "active" : "")
                  button.page-link(onclick=`changePage(${i})`) #{i}

              //- Logic nút Next
              li.page-item(class=pagination.currentPage == pagination.totalPage ? "disabled" : "")
                button.page-link(onclick=`changePage(${pagination.currentPage + 1})`)
                  i.fa-solid.fa-chevron-right

    //- Form ẩn để xử lý logic JS
    form#form-change-status(method="POST", action="", data-path="/admin/users/change-status")
    form#form-delete-item(method="POST", action="", data-path="/admin/users/delete")

block scripts
  script.
    // 1. Xử lý Lọc trạng thái (Giữ nguyên các param khác)
    function filterStatus(status) {
      let url = new URL(window.location.href);
      if (status) {
        url.searchParams.set("status", status);
      } else {
        url.searchParams.delete("status");
      }
      url.searchParams.set("page", 1); // Reset về trang 1
      window.location.href = url.href;
    }

    // 2. Xử lý Phân trang
    function changePage(page) {
      let url = new URL(window.location.href);
      url.searchParams.set("page", page);
      window.location.href = url.href;
    }

    // 3. Xử lý đổi trạng thái (Active <-> Inactive)
    function changeStatus(id, currentStatus) {
      const newStatus = currentStatus === 'active' ? 'inactive' : 'active';
      const formChangeStatus = document.querySelector("#form-change-status");
      const path = formChangeStatus.getAttribute("data-path");

      formChangeStatus.action = `${path}/${newStatus}/${id}?_method=PATCH`;
      formChangeStatus.submit();
    }

    // 4. Xử lý xóa User (Cần SweetAlert2 để đẹp hơn)
    function deleteUser(id) {
      const isConfirm = confirm("Bạn có chắc chắn muốn xóa học viên này?");
      if(isConfirm) {
        const formDeleteItem = document.querySelector("#form-delete-item");
        const path = formDeleteItem.getAttribute("data-path");
        
        formDeleteItem.action = `${path}/${id}?_method=DELETE`;
        formDeleteItem.submit();
      }
    }