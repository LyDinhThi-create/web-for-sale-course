extends ../layouts/admin.pug

block styles
  link(rel="stylesheet", href="/css/dashboard.css")
  link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")

block content
  .container
    .header
      h1
        i.fa-solid.fa-chart-line
        |  Dashboard Admin

    //- STATS GRID
    .stats-grid
      .stat-card
        .stat-header
          .stat-icon.blue
            i.fa-solid.fa-sack-dollar
        .stat-title Tổng Doanh Thu
        //- Hiển thị Doanh thu tính từ bảng User + Course
        .stat-value $#{stats.revenue}

      .stat-card
        .stat-header
          .stat-icon.green
            i.fa-solid.fa-user-group
        .stat-title Tổng Học Viên
        .stat-value #{stats.students}

      .stat-card
        .stat-header
          .stat-icon.purple
            i.fa-solid.fa-cart-shopping
        .stat-title Khóa Học Đã Bán
        .stat-value #{stats.sold}

    .charts-grid
      .chart-card
        .chart-title Biểu đồ 
        canvas#revenueChart

    .content-grid
      //- TABLE: TOP KHÓA HỌC BÁN CHẠY
      .table-card
        .chart-title Top Khóa Học Doanh Thu Cao
        .table-responsive
          table
            thead
              tr
                th Tên Khóa Học
                th Đã Bán
                th Giá Gốc
                th Tổng Thu
            tbody
              if topCourses.length > 0
                each course in topCourses
                  tr
                    td
                      .course-name
                        i.fa-solid.fa-book-open.me-2
                        | #{course.title}
                    td #{course.sold}
                    td $#{course.price}
                    td.fw-bold $#{course.revenue}
              else 
                tr
                  td(colspan="4") Chưa có dữ liệu

      //- ACTIVITY: NGƯỜI DÙNG GẦN ĐÂY
      .activity-card
        .chart-title Người Mua Gần Đây
        if activities.length > 0
          each user in activities
            .activity-item
              .activity-icon.purchase
                i.fa-solid.fa-user-check
              .activity-content
                .activity-action
                  span.activity-user #{user.fullname}
                  |  đang sở hữu
                //- Hiển thị số lượng khóa học họ đang có
                .activity-course #{user.purchasedCourses.length} khóa học
                .activity-time Cập nhật: #{new Date(user.updatedAt).toLocaleString('vi-VN')}
        else
          p.text-muted.p-3 Chưa có hoạt động nào

block scripts
  script(src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js")
  script.
    // Dữ liệu giả lập cho biểu đồ (Vì DB thiếu ngày mua)
    const backendData = {
      revenueLabels: !{chartData.labels},
      revenueValues: !{chartData.data}
    };
  script(src="/js/dashboard.js")