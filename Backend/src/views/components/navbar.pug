header.header
  .nav-container
    a.logo(href="#") eDemy

    .search-box
      input.search-input(type="text" placeholder="Search for anything")
      button.search-btn
        i.fa.fa-search(aria-hidden="true")

    nav
      ul.nav-menu
        li.nav-item
          a.nav-link(href="/",
          class=(activeMenu === 'home' ? 'active' : '')) Home
        li.nav-item.dropdown
          a.nav-link(href="#",
          class=(activeMenu === 'courses' ? 'active' : ''))
            | Courses 
            i.fa.fa-angle-down(aria-hidden="true")
          .dropdown-menu
            .dropdown-header
              h3.dropdown-title Courses
            ul.dropdown-list
              li.dropdown-item
                a.dropdown-link(href="/courses") Tất cả khóa học
              li.dropdown-item
                a.dropdown-link(href="#") Courses Style 2
              li.dropdown-item
                a.dropdown-link(href="#") Courses Style 3
              li.dropdown-item
                a.dropdown-link(href="#") Courses Style 4
        li.nav-item
          a.nav-link(href="/blog",
          class=(activeMenu === 'blog' ? 'active' : ''))
            | Blog
            i.fa.fa-angle-down(aria-hidden="true")
        li.nav-item
          a.nav-link(href="/contact",
          class=(activeMenu === 'contact' ? 'active' : ''))
            | Contact 
        li.nav-item
          .cart-icon
            i.fa.fa-cart-plus(aria-hidden="true")
            span.cart-badge 0
        li.nav-item.profile-menu-img
          if user
            img.profile-avatar(
              src=user.avatar
              alt="User Avatar"
              onerror="this.src='https://placehold.co/40x40/E0E7FF/4F46E5?text=C'"
            )
            .profile-dropdown
              // Phần Header Hồ Sơ
              .profile-header
                img.profile-avatar(
                  src=user.avatar
                  alt="User Avatar"
                  onerror="this.src='https://placehold.co/40x40/E0E7FF/4F46E5?text=C'"
                )
                .user-info
                  .user-name #{user.fullname}
                  .user-email #{user.email}

              // Phần Menu Chính
              nav.main-nav
                ul.profile-menu
                  li.profile-menu-item
                    a.profile-menu-link(href="#")
                      svg.profile-menu-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 8.25V6ZM3.75 13.5A2.25 2.25 0 0 1 6 11.25h2.25A2.25 2.25 0 0 1 10.5 13.5v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25v-2.25ZM13.5 6A2.25 2.25 0 0 1 15.75 3.75h2.25A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25A2.25 2.25 0 0 1 13.5 8.25V6ZM13.5 13.5A2.25 2.25 0 0 1 15.75 11.25h2.25A2.25 2.25 0 0 1 20.25 13.5v2.25a2.25 2.25 0 0 1-2.25 2.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z")
                      span.profile-menu-text My Courses

                  li.profile-menu-item
                    a.profile-menu-link(href="#")
                      svg.profile-menu-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25")
                      span.profile-menu-text My Learning

                  li.profile-menu-item
                    a.profile-menu-link(href="#")
                      svg.profile-menu-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 0 1-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 0 0 1.183 1.981l6.478 3.488m8.829 2.131L9.61 16.028c-.22.118-.48.118-.70 0l-6.478-3.488a2.25 2.25 0 0 1-1.183-1.98V9a2.25 2.25 0 0 1 2.25-2.25h15A2.25 2.25 0 0 1 21.75 9Z")
                      span.profile-menu-text My Purchases

                  li.profile-menu-item
                    a.profile-menu-link(href="#")
                      svg.profile-menu-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A1.875 1.875 0 0 1 18.125 22.5h-12.25a1.875 1.875 0 0 1-1.374-2.382Z")
                      span.profile-menu-text Account settings
                      hr.divider

                // Phần Đăng Xuất
                .profile-logout
                  form.profile-logout-link(action="/logout", method="POST")
                    button.logout-btn(type="submit")
                      svg.profile-logout-icon(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3H6.75A2.25 2.25 0 0 0 4.5 5.25v13.5A2.25 2.25 0 0 0 6.75 21h6.75A2.25 2.25 0 0 0 15.75 18.75V15M18 9l3 3m0 0-3 3m3-3H9")
                      span.profile-logout-text Log out

          else
            a.login-btn(href="/login-register")
              i.fa.fa-user(aria-hidden="true")
              | Login/Register
