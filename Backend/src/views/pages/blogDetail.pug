extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/blogDetail.css")

block content
  article.article-card
    .card-image
      img(src=blog.image, alt=blog.title)
    
    .card-meta
      .meta-item
        i.fas.fa-folder
        .meta-text
          span.meta-label Category
          span.meta-value #{blog.category}
      .meta-item
        i.fas.fa-user
        .meta-text
          span.meta-label View
          span.meta-value #{blog.viewCount}
      .meta-item
        i.fas.fa-calendar-alt
        .meta-text
          span.meta-label Last Updated
          span.meta-value #{blog.updatedAt.toLocaleDateString('vi-VN')}
    
    .card-content
      h2.card-title
        a(href="#") #{blog.title}
      each paragraph in blog.fullDescription
        p.card-excerpt #{paragraph}
        br