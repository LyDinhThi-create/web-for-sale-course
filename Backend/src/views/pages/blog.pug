extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/blog.css")

block content
  .page-header
      .container
        .breadcrumb
          a(href="/") Home
          span /
          span course
        
        h1.page-title Danh sách blog

        //- Icon trang trí dấu X màu xanh
        .decor-icon
          i.fa-solid.fa-plus
  .blog-section
    .blog-grid
      // Blog Card 1
      each itemBlog in blogs
        article.blog-card
          .blog-image-container
            img.blog-image(src=itemBlog.image, alt=itemBlog.title)
          .blog-content
            span.blog-category #{itemBlog.category}
            h3.blog-title
              a(href=`/blog/${itemBlog._id}`) #{itemBlog.title}
            .blog-meta
              .blog-author
                .author-avatar #{itemBlog.instructor.avatar}
                span.author-name #{itemBlog.instructor.name}
              .blog-date
                svg.date-icon(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                  rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
                  line(x1="16", y1="2", x2="16", y2="6")
                  line(x1="8", y1="2", x2="8", y2="6")
                  line(x1="3", y1="10", x2="21", y2="10")
                | #{itemBlog.createdAt.toLocaleDateString('vi-VN')}
                
      //- article.blog-card
      //-   .blog-image-container
      //-     .blog-image.blog-img-1
      //-   .blog-content
      //-     span.blog-category Education
      //-     h3.blog-title
      //-       | 28 Student-Centered Instructional Strategies
      //-     .blog-meta
      //-       .blog-author
      //-         .author-avatar AM
      //-         span.author-name Alex Morgan
      //-       .blog-date
      //-         svg.date-icon(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
      //-           rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
      //-           line(x1="16", y1="2", x2="16", y2="6")
      //-           line(x1="8", y1="2", x2="8", y2="6")
      //-           line(x1="3", y1="10", x2="21", y2="10")
      //-         | April 30, 2020

     
    // Pagination
    .pagination
      a.pagination-btn(class= currentPage===1 ? 'disabled' : '', href=`?page=${currentPage-1}`)
        svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
          polyline(points="15 18 9 12 15 6")
      each i in Array.from({ length: totalPages }, (_, index) => index + 1)
        if currentPage === i
          a.pagination-btn.active(href=`?page=${i}`) #{i}
        else
          a.pagination-btn(href=`?page=${i}`) #{i}
      a.pagination-btn(class= currentPage===totalPages ? 'disabled' : '', href=`?page=${currentPage+1}`)
        svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
          polyline(points="9 18 15 12 9 6")