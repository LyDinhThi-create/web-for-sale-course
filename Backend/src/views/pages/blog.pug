extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/blog.css")

block content
  .blog-section
    .blog-grid
      // Blog Card 1
      article.blog-card
        .blog-image-container
          .blog-image.blog-img-1
        .blog-content
          span.blog-category Education
          h3.blog-title
            | 28 Student-Centered Instructional Strategies
          .blog-meta
            .blog-author
              .author-avatar AM
              span.author-name Alex Morgan
            .blog-date
              svg.date-icon(viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
                rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
                line(x1="16", y1="2", x2="16", y2="6")
                line(x1="8", y1="2", x2="8", y2="6")
                line(x1="3", y1="10", x2="21", y2="10")
              | April 30, 2020

      // Blog Card 2
      article.blog-card
        .blog-image-container
          .blog-image.blog-img-2
