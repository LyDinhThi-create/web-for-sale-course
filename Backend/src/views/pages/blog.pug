    // Pagination
    .pagination
      a.pagination-btn.disabled(href="#")
        svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
          polyline(points="15 18 9 12 15 6")
      a.pagination-btn.active(href="#") 1
      a.pagination-btn(href="#") 2
      a.pagination-btn(href="#") 3
      a.pagination-btn(href="#") 4
      a.pagination-btn(href="#")
        svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2")
