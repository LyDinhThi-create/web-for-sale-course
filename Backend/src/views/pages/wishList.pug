extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/mypurchases.css")

block content
  // Main Content Section
  section
    //- Phần Header
    .page-header
      .container
        .breadcrumb
          a(href="/") Home
          span /
          span Wish list
        
        h1.page-title Các khóa học yêu thích

        .decor-icon
          i.fa-solid.fa-plus
    
    //- Phần Danh sách khóa học
    .courses-container
      .courses-grid
        if courses.length === 0
          p Bạn chưa có khóa học yêu thích nào.
        else
          each course in courses
            .course-card
              //- Phần Ảnh
              .course-image.course-1
                img(src=course.image, alt=course.title)
                button.wishlist-btn.active( data-id=course._id)
                  svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                    path(d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z")
                
                .course-price $#{course.price}

              //- Phần Nội dung
              .course-content
                .instructor
                  //- Giả sử avatar là link ảnh, nên dùng thẻ img, còn nếu là div thì giữ nguyên
                  .instructor-avatar #{course.instructor.avatar}
                  span.instructor-name #{course.instructor.name}

                a.course-title(href=`/courses/${course._id}`) #{course.title}
                p.course-description #{course.description}

                .course-stats
                  .stat-item
                    svg.stat-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      path(d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z")
                    | #{course.lessonCount} Lessons

                  .stat-item
                    svg.stat-icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      path(d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2")
                      circle(cx="9" cy="7" r="4")
                      path(d="m22 21-3-3m0 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0")
                    | #{course.students} Students

      //- Phần Phân trang (Pagination) - Đặt ngoài .courses-grid nhưng trong .courses-container
      if totalPages > 1
        ul.pagination
          li.pagination-link(class= currentPage===1 ? 'disabled' : '') 
            //- Kiểm tra biến currentSort và limit có tồn tại không để tránh lỗi undefined
            - var sortParam = currentSort || 'createdAt:desc'
            - var limitParam = limit || 10
            a(href=`?sort=${sortParam}&page=${currentPage-1}&limit=${limitParam}`) &laquo; Quay lại
          
          each i in Array.from({ length: totalPages }, (_, index) => index + 1)
            li.pagination-link(class= currentPage===i ? 'active' : '')
              a(href=`?sort=${sortParam}&page=${i}&limit=${limitParam}`) #{i}
          
          li.pagination-link(class= currentPage===totalPages ? 'disabled' : '') 
            a(href=`?sort=${sortParam}&page=${currentPage+1}&limit=${limitParam}`) Tiếp &raquo;