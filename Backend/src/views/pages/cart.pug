extends ../layouts/main.pug

block styles
  link(rel="stylesheet", href="/css/cart.css")

block content
  .container
    table.cart-table
      thead
        tr
          th.thumb-col THUMB
          th TITLE
          th PRICE
          th.action-col
      tbody#cart-items-container
        each course in courses
          tr.cart-item(data-id=course.id)
            td.thumb-col 
              a(href=`/courses/${course.id}`).product-thumb
                //- Nếu có link ảnh thật thì dùng img, chưa có thì giữ nguyên icon
                if course.image
                  img(src=course.image, alt=course.title)
                else
                  i.fa-regular.fa-image(style="color:#ccc;")

            td.title-col
              a.product-title(href=`/courses/${course.id}`,style="text-decoration: none;") #{course.title}
              

            td.price-col $#{course.price}

            td.action-col
              a.delete-btn(data-course-id=course.id)
                i.fa-solid.fa-trash-can(data-course-id=course.id)

    .cart-totals-container
      .cart-totals
        h2 Cart Totals
        .total-row
          span.total-label Total
          span.total-amount#cart-total-price(total-Price= totalPrice) $#{totalPrice}
        button.checkout-btn
          i.fa-solid.fa-cart-shopping
          |  Buy Now with MOMO
        button.checkout-btn-vnpay
          i.fa-solid.fa-cart-shopping
          |  Buy Now with VNPAY
block scripts
  script(src="/js/cart.js")