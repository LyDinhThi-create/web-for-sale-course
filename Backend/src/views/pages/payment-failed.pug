doctype html
html(lang="vi")
  head
    title Thanh toán thất bại
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet")
  body
    .container.mt-5.text-center
      .card.border-danger.mb-3.mx-auto(style="max-width: 500px;")
        .card-header.bg-danger.text-white Lỗi thanh toán
        .card-body.text-danger
          h1.display-4 ❌
          h5.card-title Giao dịch thất bại!
          p.card-text Có lỗi xảy ra trong quá trình thanh toán hoặc bạn đã hủy giao dịch.
          a.btn.btn-warning.mt-3(href="/cart") Quay lại giỏ hàng