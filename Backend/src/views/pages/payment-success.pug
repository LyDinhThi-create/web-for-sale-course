doctype html
html(lang="vi")
  head
    title Thanh toán thành công
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css", rel="stylesheet")
  body
    .container.mt-5.text-center
      .card.border-success.mb-3.mx-auto(style="max-width: 500px;")
        .card-header.bg-success.text-white Thông báo
        .card-body.text-success
          h1.display-4 ✅
          h5.card-title Thanh toán thành công!
          p.card-text Cảm ơn bạn đã mua hàng. Đơn hàng của bạn đang được xử lý.
          a.btn.btn-primary.mt-3(href="/") Quay về trang chủ